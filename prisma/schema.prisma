datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PlanTier {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum PaymentChannel {
  STRIPE_SUBSCRIPTION
  BASE_SEPOLIA_USDC
}

model Profile {
  id                   String             @id @default(uuid())
  email                String             @unique
  stripeCustomerId     String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  planTier             PlanTier           @default(FREE) @map("plan_tier")
  subscriptionStatus   SubscriptionStatus @default(ACTIVE) @map("subscription_status")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  apiKeys   ApiKey[]
  auditLogs AuditLog[]

  @@map("profiles")
}

model ApiKey {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  keyHash      String   @unique @map("key_hash")
  keyPrefix    String   @map("key_prefix")
  name         String   @default("Default API Key")
  monthlyLimit Int      @default(100) @map("monthly_limit")
  usageCount   Int      @default(0) @map("usage_count")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@map("api_keys")
}

model AuditLog {
  id              String         @id @default(uuid())
  userId          String?        @map("user_id")
  auditId         String         @unique @map("audit_id")
  billedVia       PaymentChannel @map("billed_via")
  targetLicense   String         @default("MIT") @map("target_license")
  packagesScanned Json           @map("packages_scanned")
  reportOutput    Json           @map("report_output")
  createdAt       DateTime       @default(now()) @map("created_at")

  user Profile? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([auditId])
  @@map("audit_logs")
}
